# =============================================================================
# SwiftDrop Local Dev — Environment Configuration
# Copy this file to .env in local-dev/ or services/notification-service/
# =============================================================================

# --- Database & RabbitMQ (Pre-configured for local-dev/docker-compose.yml) ---
POSTGRES_PORT=5433
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- Email / SMTP Configuration ---
# Default for local testing (uses Mailpit in Docker, no credentials needed):
# SPRING_MAIL_ENABLED=true
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_FROM=noreply@swiftdrop.lk

# To send REAL emails to real inboxes via Gmail, uncomment and set below:

SPRING_MAIL_ENABLED=true
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=sanjulaaravinda2003@gmail.com
SPRING_MAIL_PASSWORD=pnjs eqks ctej ggly
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
SPRING_MAIL_FROM=sanjulaaravinda2003@gmail.com