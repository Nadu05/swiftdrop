# ==========================================
# SwiftDrop Local / Hybrid Development Env
# ==========================================
# Copy this file to .env and fill in your local or development values.
# NEVER commit real credentials or secrets to version control.

# ------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------
NEON_HOST=localhost:5432
NEON_USER=postgres
NEON_PASSWORD=<CHANGE_ME_DB_PASSWORD>
POSTGRES_PASSWORD=replace_with_local_postgres_password
NEON_SSLMODE=disable

IDENTITY_DB_NAME=identity_db
ORGANIZATION_DB_NAME=organization_db
ORDER_DB_NAME=order_db
DISPATCH_DB_NAME=dispatch_db
NOTIFICATION_DB_NAME=notification_db

# ------------------------------------------
# RabbitMQ Broker Configuration
# ------------------------------------------
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=<CHANGE_ME_RABBITMQ_PASSWORD>

# ------------------------------------------
# Host Port Mappings
# ------------------------------------------
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
API_GATEWAY_PORT=8080
IDENTITY_PORT=8081
ORGANIZATION_PORT=8082
ORDER_PORT=8083
DISPATCH_PORT=8084
NOTIFICATION_PORT=8085
FRONTEND_PORT=3000

# ------------------------------------------
# Application Configuration
# ------------------------------------------
SPRING_PROFILES_ACTIVE=default
SWIFTDROP_EVENTS_EXCHANGE=swiftdrop.events

# ------------------------------------------
# Auth & Security Secrets (Must be set in .env)
# ------------------------------------------
JWT_SECRET=<CHANGE_ME_GENERATE_BASE64_256BIT_SECRET>
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000
GOOGLE_CLIENT_ID=<CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID>
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------
# Frontend Configuration
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID>


# ------------------------------------------
# SwiftDrop AI Assistant (Order Service)
# ------------------------------------------
SWIFTDROP_AI_ENABLED=true
SWIFTDROP_AI_PROVIDER=gemini
SWIFTDROP_AI_MODEL=gemini-3.5-flash-lite
SWIFTDROP_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SWIFTDROP_AI_API_KEY=
# OpenAI (alternative) example:
# SWIFTDROP_AI_PROVIDER=openai
# SWIFTDROP_AI_MODEL=gpt-4o-mini
# SWIFTDROP_AI_BASE_URL=https://api.openai.com
# Groq example:
# SWIFTDROP_AI_PROVIDER=groq
# SWIFTDROP_AI_MODEL=llama-3.1-8b-instant
# SWIFTDROP_AI_BASE_URL=https://api.groq.com/openai/v1
