# SwiftDrop Frontend Environment Configuration Template
# Copy to .env.local for local overrides

# Spring Cloud API Gateway Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Development Preview Mode for Branch Manager Dashboard
# Set to 'true' to activate development preview mode with realistic mock data
# Set to 'false' in production or staging environments
NEXT_PUBLIC_BRANCH_DASHBOARD_PREVIEW=false

