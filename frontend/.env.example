# ============================================================
# SwiftDrop Frontend Environment Configuration
# ============================================================

# API Gateway Base URL
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# Google OAuth 2.0 Client ID for client-side Google Sign-In
# Use 'demo-client-id' for local testing without Google Cloud credentials,
# or your real Client ID from Google Cloud Console (e.g. xxx.apps.googleusercontent.com)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=demo-client-id

