# SwiftDrop Frontend Environment Configuration Template
# Copy to .env.local for local overrides

# Spring Cloud API Gateway Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional Map & Geocoding Provider Overrides (Public / Keyless OpenStreetMap & Nominatim defaults used when omitted)
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_GEOCODING_API_URL=https://nominatim.openstreetmap.org

# Dispatch (dispatcher + courier portal): 'api' uses the real dispatch-service, unset/'mock' uses in-memory mock data
# NEXT_PUBLIC_DISPATCH_API_MODE=api
# TEMPORARY until login exists: the courier's couriers.user_id, sent as X-User-Id (990103 = dev seed courier CR-103)
# NEXT_PUBLIC_DEV_COURIER_USER_ID=990103
